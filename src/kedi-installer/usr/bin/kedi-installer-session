#!/bin/sh
# Calamares derives its initial language and locale from this environment.
# Do not let a missing C.UTF-8 locale or other non-UTF-8 override force the
# installer back to the byte-oriented C locale.
available_utf8_locales=$(
    LC_ALL=C locale -a 2>/dev/null |
        tr '[:upper:]' '[:lower:]' |
        sed -E 's/\.utf-?8$/.utf8/; /\.utf8$/!d'
)

locale_is_available_utf8() {
    locale_name=$(printf '%s\n' "$1" |
        tr '[:upper:]' '[:lower:]' |
        sed -E 's/\.utf-?8$/.utf8/')
    case "$locale_name" in
        *.utf8) ;;
        *) return 1 ;;
    esac
    printf '%s\n' "$available_utf8_locales" | grep -Fqx "$locale_name"
}

if ! locale_is_available_utf8 "${LANG:-}"; then
    if locale_is_available_utf8 en_US.UTF-8; then
        LANG=en_US.UTF-8
    elif locale_is_available_utf8 tr_TR.UTF-8; then
        LANG=tr_TR.UTF-8
    else
        echo 'kedi-installer-session: no supported UTF-8 locale is installed' >&2
        exit 1
    fi
fi
export LANG

for category in LC_ALL LC_CTYPE LC_COLLATE LC_MESSAGES LC_MONETARY LC_NUMERIC \
                LC_TIME LC_ADDRESS LC_IDENTIFICATION LC_MEASUREMENT LC_NAME \
                LC_PAPER LC_TELEPHONE; do
    locale_value=$(printenv "$category" 2>/dev/null || :)
    if [ -n "$locale_value" ] && ! locale_is_available_utf8 "$locale_value"; then
        unset "$category"
    fi
done

openbox &
exec dbus-run-session calamares
