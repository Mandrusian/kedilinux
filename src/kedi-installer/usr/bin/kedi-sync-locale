#!/bin/sh
set -eu

target_root=${1:?usage: kedi-sync-locale TARGET_ROOT}
locale_file=${target_root%/}/etc/default/locale
environment_file=${target_root%/}/etc/environment
target_locale_archive=${target_root%/}/usr/lib/locale/locale-archive
source_locale_archive=${KEDI_SOURCE_LOCALE_ARCHIVE:-/usr/lib/locale/locale-archive}

if [ ! -r "$locale_file" ]; then
    echo "kedi-sync-locale: missing locale file: $locale_file" >&2
    exit 1
fi

temporary_file=$(mktemp "${environment_file}.XXXXXX")
trap 'rm -f "$temporary_file"' 0 HUP INT TERM

if [ -f "$environment_file" ]; then
    awk '!/^[[:space:]]*(LANG|LC_[[:alnum:]_]+)[[:space:]]*=/' \
        "$environment_file" > "$temporary_file"
fi

awk -F= '($1 == "LANG" || ($1 ~ /^LC_[[:alnum:]_]+$/ && $1 != "LC_ALL")) { print }' \
    "$locale_file" >> "$temporary_file"

if [ -f "$environment_file" ]; then
    chmod --reference="$environment_file" "$temporary_file"
    chown --reference="$environment_file" "$temporary_file"
else
    chmod 0644 "$temporary_file"
fi

mv -f "$temporary_file" "$environment_file"
trap - 0 HUP INT TERM

# Calamares' localecfg module runs locale-gen against the target. On Kedi's
# live image, /etc/locale.gen only enables tr_TR.UTF-8, so the generated
# archive can lose en_US.UTF-8 even though the live image has both locales.
# Restore the shipped archive if either supported desktop locale is missing.
source_locales=$(LC_ALL=C localedef --list-archive "$source_locale_archive" 2>/dev/null || :)
target_locales=$(LC_ALL=C localedef --list-archive "$target_locale_archive" 2>/dev/null || :)

locale_is_in_list() {
    wanted=$(printf '%s\n' "$1" | tr '[:upper:]' '[:lower:]' |
        sed -E 's/\.utf-?8$/.utf8/')
    printf '%s\n' "$2" | tr '[:upper:]' '[:lower:]' |
        sed -E 's/\.utf-?8$/.utf8/' | grep -Fqx "$wanted"
}

locales_need_restore=false
for required_locale in en_US.UTF-8 tr_TR.UTF-8; do
    if ! locale_is_in_list "$required_locale" "$target_locales"; then
        if ! locale_is_in_list "$required_locale" "$source_locales"; then
            echo "kedi-sync-locale: $required_locale is absent from both locale archives" >&2
            exit 1
        fi
        locales_need_restore=true
    fi
done

if [ "$locales_need_restore" = true ]; then
    if [ ! -r "$source_locale_archive" ]; then
        echo "kedi-sync-locale: missing live locale archive: $source_locale_archive" >&2
        exit 1
    fi
    mkdir -p "$(dirname "$target_locale_archive")"
    archive_temporary=$(mktemp "${target_locale_archive}.XXXXXX")
    trap 'rm -f "$temporary_file" "$archive_temporary"' 0 HUP INT TERM
    cp "$source_locale_archive" "$archive_temporary"
    if [ -e "$target_locale_archive" ]; then
        chmod --reference="$target_locale_archive" "$archive_temporary"
        chown --reference="$target_locale_archive" "$archive_temporary"
    else
        chmod 0644 "$archive_temporary"
    fi
    mv -f "$archive_temporary" "$target_locale_archive"

    target_locales=$(LC_ALL=C localedef --list-archive "$target_locale_archive" 2>/dev/null || :)
    for required_locale in en_US.UTF-8 tr_TR.UTF-8; do
        if ! locale_is_in_list "$required_locale" "$target_locales"; then
            echo "kedi-sync-locale: failed to install $required_locale in target archive" >&2
            exit 1
        fi
    done
fi

trap - 0 HUP INT TERM
